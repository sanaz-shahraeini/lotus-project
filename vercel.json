{
  "version": 2,
  "buildCommand": "bash build.sh",
  "builds": [
    {
      "src": "lotus/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "excludeFiles": "staticfiles/**"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "lotus/wsgi.py"
    }
  ]
}
