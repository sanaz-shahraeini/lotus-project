{
  "builds": [
    {
      "src": "lotus/asgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "lotus/asgi.py"
    }
  ],
  "functions": {
    "lotus/asgi.py": {
      "excludeFiles": "{logs/**,static/**,staticfiles/**,lotus-backup/**,*.rar,*.bak,celery/**}"
    }
  }
}